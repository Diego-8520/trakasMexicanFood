---
// Hero del concepto B "Cine de comal".
// Móvil y tableta: video 3:4 a pantalla completa bajo un velo oscuro.
// Escritorio (≥1024 px): el video va entero en una "pantalla" vertical a la derecha, con un
// resplandor cálido detrás; texto a la izquierda y el Chile asomado al borde de la pantalla.
import { Image } from 'astro:assets';
import VideoSection from '../VideoSection.astro';
import { whatsappUrl } from '../../lib/formato';
import provisional from '../../assets/posters/hero-provisional.webp';
import { posterDe } from '../../lib/media';
import { marca } from '../../data/trakas';
import chile from '../../assets/brand/mascota/chile-presentando-sticker.webp';
// Video de fondo (vertical 3:4): media-original/hero.mp4 → npm run media
const poster = posterDe('hero') ?? provisional;
---
<section class="hero" aria-labelledby="hero-titulo">
  <VideoSection clip="hero" poster={poster} alt="" prioridad class="hero__fondo"
    sizes="(min-width: 1024px) 44vw, 100vw">
    <span class="hero__sello label" aria-hidden="true">Directo del comal</span>
  </VideoSection>
  <div class="hero__velo" aria-hidden="true"></div>

  <div class="hero__texto">
    <p class="label kicker">Taquería · Tortillas artesanales</p>
    <h1 id="hero-titulo" class="display titulo"><span>Birria que se moja</span> <span>en consomé.</span></h1>
    <p class="sub">Res marinada en chiles y cocida lento, en tortilla artesanal dorada al comal. Cebolla, cilantro y un consomé que pide otra ronda.</p>
    <div class="ctas">
      <a class="btn btn--sol label" href={whatsappUrl(marca.whatsapp.pedido)} target="_blank" rel="noopener">Pedir por WhatsApp</a>
      <a class="btn btn--vidrio label" href="/menu">Ver el menú</a>
    </div>
  </div>

  <figure class="anfitrion">
    <figcaption class="globo">¡Bienvenido! Yo te recomiendo la birria.</figcaption>
    <Image data-mascota-hero src={chile} alt="El Chile, anfitrión de Trakas"
      widths={[160, 240, 340, 480, 680]} sizes="(min-width: 768px) clamp(220px, 24vw, 340px), 150px"
      loading="eager" quality={78} />
  </figure>
  <p class="desliza label" aria-hidden="true">Desliza</p>
</section>

<style>
  .hero { position: relative; min-height: calc(100dvh - var(--nav-h)); display: grid; grid-template-rows: 1fr auto; overflow: hidden; isolation: isolate; background: #0e0c0b; }
  :global(.hero__fondo) { position: absolute !important; inset: 0; z-index: -2; }
  .hero__sello { display: none; }
  .hero__velo { position: absolute; inset: 0; z-index: -1; background:
      linear-gradient(90deg, rgba(14,12,11,.92) 0%, rgba(14,12,11,.65) 45%, rgba(14,12,11,0) 75%),
      linear-gradient(0deg, #0e0c0b 0%, transparent 30%); }

  .hero__texto { align-self: center; padding: 0 clamp(1.2rem, 6vw, 6rem); max-width: 52rem; }
  .titulo { font-size: clamp(3rem, 5.4vw, 5.2rem); line-height: .92; color: var(--tortilla); }
  .titulo span { display: block; white-space: nowrap; animation: sube .8s var(--ease-out) both; }
  .titulo span + span { animation-delay: .1s; }
  @keyframes sube { from { opacity: 0; transform: translateY(24px); } }
  .sub { max-width: 34rem; margin: 1.6rem 0 0; color: rgba(255,246,229,.82); font-size: 1.1rem; line-height: 1.65; }
  .ctas { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 2.2rem; }

  /* Ancho del Chile y espacio que ocupa el anfitrión (Chile + globo) a la derecha: el texto no entra ahí */
  .hero { --chile-w: clamp(220px, 24vw, 340px); --chile-der: clamp(1rem, 5vw, 5rem); }
  @media (min-width: 768px) {
    .hero__texto { max-width: min(52rem, calc(100% - var(--chile-w) - var(--chile-der) - 7rem)); }
  }
  .anfitrion { position: absolute; z-index: 3; right: var(--chile-der); bottom: 2.5rem; margin: 0;
    animation: flota 4.5s ease-in-out infinite; }
  .anfitrion :global(img) { display: block; width: var(--chile-w); height: auto; filter: drop-shadow(0 20px 30px rgba(0,0,0,.6)); }
  /* Globo pegado al Chile: su esquina con cola apunta a la cara */
  .globo { position: absolute; right: 64%; bottom: 60%; width: max-content; max-width: 11.5rem; margin: 0;
    padding: .7rem .95rem; border-radius: 16px 16px 4px 16px;
    background: var(--tortilla); color: var(--comal); font-weight: 700; font-size: .95rem; line-height: 1.3; box-shadow: 0 10px 30px rgba(0,0,0,.4); }
  .globo::after { content: ''; position: absolute; right: -11px; bottom: 0; width: 14px; height: 14px;
    background: inherit; clip-path: polygon(0 0, 0 100%, 100% 100%); }
  @keyframes flota { 50% { transform: translateY(-8px); } }
  .desliza { justify-self: center; padding-bottom: 1.4rem; color: var(--tortilla-dim); font-size: .85rem; letter-spacing: .06em; }

  /* Escritorio: el video 3:4 entero en una pantalla vertical a la derecha */
  @media (min-width: 1024px) {
    .hero {
      --panel-der: clamp(2rem, 5vw, 5rem);
      --panel-h: min(calc(100dvh - var(--nav-h) - 5rem), 44vw * 4 / 3);
      --panel-w: calc(var(--panel-h) * .75);
    }
    /* Resplandor de brasa detrás de la pantalla */
    .hero { background:
      radial-gradient(calc(var(--panel-w) * 1.05) calc(var(--panel-h) * .7) at calc(100% - var(--panel-der) - var(--panel-w) / 2) 50%,
        rgba(242,106,27,.22), rgba(214,39,24,.08) 55%, transparent 100%),
      #0e0c0b; }
    :global(.hero__fondo) {
      inset: auto !important; top: 50% !important; right: var(--panel-der) !important;
      width: var(--panel-w); height: var(--panel-h); transform: translateY(-50%);
      border-radius: 24px;
      box-shadow: 0 0 0 1px rgba(255,246,229,.12), 0 40px 80px -20px rgba(0,0,0,.8);
      animation: pantalla 1s var(--ease-out) .15s both;
    }
    /* Viñeta interior: funde el borde del video con el comal */
    :global(.hero__fondo)::after {
      content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; border-radius: inherit;
      box-shadow: inset 0 0 60px rgba(14,12,11,.55);
      background: linear-gradient(0deg, rgba(14,12,11,.45) 0%, transparent 28%);
    }
    .hero__sello {
      display: inline-block; position: absolute; top: 1.2rem; left: 1.2rem;
      padding: .35rem .8rem .2rem; background: var(--chile); color: var(--tortilla);
      font-size: 1rem; transform: rotate(-3deg); box-shadow: 0 6px 14px rgba(0,0,0,.4);
    }
    .hero__velo { background: linear-gradient(0deg, #0e0c0b 0%, transparent 18%); }
    .hero__texto { max-width: min(46rem, calc(100% - var(--panel-w) - var(--panel-der) - 4rem)); padding-right: 0; }
    /* El Chile se asoma por el borde izquierdo de la pantalla */
    .anfitrion { right: calc(var(--panel-der) + var(--panel-w) - var(--chile-w) * .45); bottom: 1.5rem; }
    /* El globo sube sobre la cabeza del Chile, hacia la pantalla: nunca tapa el texto */
    .globo { z-index: 1; right: auto; left: 46%; bottom: calc(100% + .4rem); border-radius: 16px 16px 16px 4px; }
    .globo::after { right: auto; left: 0; bottom: -11px; clip-path: polygon(0 0, 100% 0, 0 100%); }
    .desliza { display: none; }
  }
  @keyframes pantalla { from { transform: translateY(calc(-50% + 28px)) scale(.97); } }

  @media (max-width: 767px) {
    .hero__velo { background: linear-gradient(0deg, #0e0c0b 15%, rgba(14,12,11,.55) 60%, rgba(14,12,11,.3)); }
    .hero__texto { align-self: end; padding-bottom: 15rem; }
    .titulo { font-size: 2.6rem; }
    .titulo span { white-space: normal; }
    .anfitrion { right: .5rem; bottom: 1rem; }
    .anfitrion :global(img) { width: 150px; }
    .globo { display: none; }
    .desliza { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .anfitrion { animation: none; } }
</style>
