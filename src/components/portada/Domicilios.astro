---
import { Image } from 'astro:assets';
import WhatsAppCTA from '../WhatsAppCTA.astro';
import EstadoHorario from '../EstadoHorario.astro';
import { trakas } from '../../data/trakas';
import moto from '../../assets/brand/mascota/chile-moto.png';
---
<section id="domicilios" class="dom" aria-labelledby="dom-titulo">
  <div class="dom__texto">
    <p class="label kicker">Domicilios</p>
    <h2 id="dom-titulo" class="display seccion-titulo">Te lo llevamos<br /><span>volando</span></h2>
    <p>Escríbenos por WhatsApp, elige tu plato y tu proteína, y el Chile sale en moto con tu pedido caliente.</p>
    <div class="dom__acciones">
      <WhatsAppCTA mensaje="¡Hola Trakas! Quiero un domicilio" />
      <span class="dom__tel label">{trakas.telefonoVisible}</span>
    </div>
    <EstadoHorario variante="chip" />
  </div>
  <div class="dom__arte">
    <div class="dom__vel" aria-hidden="true"></div>
    <Image src={moto} alt="El Chile repartiendo en moto" widths={[360, 560, 760]} sizes="(min-width: 900px) 40vw, 80vw" quality={75} class="dom__moto" />
  </div>
</section>
<style>
  .dom { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 2rem; overflow: hidden;
    padding: clamp(4rem, 8vw, 7rem) clamp(1.2rem, 5vw, 5rem);
    background: linear-gradient(160deg, #1f1714, var(--comal)); border-block: 1px solid rgba(255,246,229,.08); }
  .seccion-titulo span { color: var(--maiz); }
  .dom__texto > p { max-width: 32rem; color: rgba(255,246,229,.78); font-size: 1.08rem; line-height: 1.65; margin: 1.4rem 0 1.8rem; }
  .dom__acciones { display: flex; align-items: center; flex-wrap: wrap; gap: 1.2rem; margin-bottom: 1.4rem; }
  .dom__tel { font-size: 1.5rem; color: var(--tortilla); }
  .dom__arte { position: relative; }
  .dom__vel { position: absolute; inset: 40% 30% 30% -20%; background: repeating-linear-gradient(0deg, transparent 0 18px, rgba(255,194,26,.35) 18px 22px); -webkit-mask: linear-gradient(90deg, transparent, #000); mask: linear-gradient(90deg, transparent, #000); }
  :global(.dom__moto) { position: relative; width: 100%; max-width: 560px; height: auto; filter: drop-shadow(0 26px 30px rgba(0,0,0,.5)); }
  @supports (animation-timeline: view()) {
    :global(.dom__moto) { animation: llega linear both; animation-timeline: view(); animation-range: entry 0% cover 40%; }
    @keyframes llega { from { transform: translateX(45%) rotate(4deg); opacity: 0; } to { transform: none; opacity: 1; } }
  }
  @media (max-width: 899px) { .dom { grid-template-columns: 1fr; } .dom__arte { order: -1; max-width: 420px; } }
  @media (prefers-reduced-motion: reduce) { :global(.dom__moto) { animation: none !important; } }
</style>
