---
import type { Plato } from '../data/trakas';
import { formatoPrecio } from '../lib/formato';
interface Props { platos: Plato[]; variante: 'compacta' | 'portada' }
const { platos, variante } = Astro.props;
---
<ol class:list={['platos', `platos--${variante}`]}>
  {platos.map((p, i) => (
    <li class:list={['plato', { 'plato--destacado': p.destacado }]} data-plato={p.id}>
      <span class="plato__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <div class="plato__cuerpo">
        <h3 class="plato__nombre display">{p.nombre}</h3>
        <p class="plato__desc">{p.desc}</p>
      </div>
      <p class="plato__precio label"><span class="sr-only">Precio: </span>{formatoPrecio(p.precio)}</p>
      {p.destacado && <span class="plato__sello label" aria-label="Favorito de la casa">★ Favorito</span>}
    </li>
  ))}
</ol>

<style>
  .platos { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .plato {
    position: relative; display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto;
    column-gap: .9rem; padding: 1.15rem 1.1rem 1.1rem .9rem;
    background: linear-gradient(160deg, var(--comal-2), var(--comal-3));
    border: 1px solid rgba(255,246,229,.08); border-radius: var(--radius);
    overflow: hidden;
  }
  .plato::before { /* filo de color a la izquierda */
    content: ''; position: absolute; inset: 0 auto 0 0; width: 4px; background: var(--fuego);
  }
  .plato--destacado { border-color: rgba(255,194,26,.45); background: linear-gradient(160deg, #2a1d12, #1f1714); }
  .plato--destacado::before { background: var(--maiz); }
  .plato__num {
    grid-row: 1 / 3; font: 400 2.6rem/0.9 var(--f-label);
    color: transparent; -webkit-text-stroke: 1.5px rgba(242,106,27,.75);
    padding-top: .1rem;
  }
  .plato__nombre { font-size: 1.75rem; color: var(--tortilla); line-height: 1; padding-right: 4.5rem; }
  .plato__desc { margin: .45rem 0 0; color: var(--tortilla-dim); font-size: .95rem; line-height: 1.45; }
  .plato__precio {
    grid-column: 2; justify-self: start; margin: .8rem 0 0;
    padding: .3rem .75rem .2rem; font-size: 1.35rem; line-height: 1;
    background: var(--maiz); color: var(--comal);
    clip-path: polygon(8px 0, 100% 0, 100% 100%, 8px 100%, 0 50%);
    padding-left: 1rem; transform: rotate(-2deg);
  }
  .plato__sello {
    position: absolute; top: .8rem; right: -.2rem; padding: .25rem .8rem .2rem .7rem;
    background: var(--chile); color: #fff; font-size: .95rem; line-height: 1;
    transform: rotate(4deg); box-shadow: 0 4px 10px rgba(0,0,0,.35);
  }
  @media (min-width: 720px) {
    .platos--portada { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  }
</style>
