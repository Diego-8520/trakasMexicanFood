---
// CONCEPTO B — "Cine de comal": premium y cinematográfico; video a sangre, la mascota como anfitrión. (Maqueta desechable)
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Hueco from '../../components/conceptos/Hueco.astro';
import { trakas } from '../../data/trakas';
import { formatoPrecio, whatsappUrl } from '../../lib/formato';
import logo from '../../assets/brand/logo/logo-sticker.png';
import presentando from '../../assets/brand/mascota/chile-presentando-sticker-1024.webp';
const capitulos = trakas.menu.platos.filter((p) => ['birria', 'ramen', 'gringas', 'volcanes'].includes(p.id));
---
<Base title="Concepto B — Cine de comal" description="Maqueta" noIndex>
  <section class="hero">
    <Hueco class="hero__video" texto="Tu video a pantalla completa: comal humeando, birria desmechándose (8 s)" />
    <div class="hero__velo" aria-hidden="true"></div>
    <header class="nav">
      <Image src={logo} alt="Trakas Mexican Food" width={84} densities={[1, 2]} />
      <nav class="label"><a href="#">Menú</a><a href="#">Historia</a><a href="#">Visítanos</a></nav>
    </header>
    <div class="hero__texto">
      <p class="label kicker"><span></span>Taquería · Desde el comal</p>
      <h1 class="display titulo"><span>Birria que se moja</span><span>en consomé.</span></h1>
      <p class="sub">Res marinada en chiles y cocida lento hasta deshacerse. Tortilla dorada, cebolla, cilantro y un consomé que pide otra ronda.</p>
      <div class="ctas">
        <a class="btn btn--sol label" href={whatsappUrl()}>Pedir por WhatsApp</a>
        <a class="btn btn--vidrio label" href="/menu">Ver el menú</a>
      </div>
    </div>
    <figure class="anfitrion">
      <Image src={presentando} alt="El Chile, anfitrión de Trakas" width={200} densities={[1, 2]} loading="eager" />
      <figcaption class="globo">¡Bienvenido! Yo te recomiendo la birria.</figcaption>
    </figure>
    <p class="scroll label" aria-hidden="true">Desliza</p>
  </section>

  <section class="caps">
    <div class="caps__cab">
      <p class="label kicker"><span></span>La carta, por capítulos</p>
      <h2 class="display caps__titulo">Cuatro razones<br />para volver</h2>
    </div>
    <div class="caps__pista">
      {capitulos.map((p, i) => (
        <article class="cap">
          <Hueco class="cap__video" texto={`Clip vertical: ${p.nombre}`} />
          <div class="cap__info">
            <span class="label cap__n">Cap. 0{i + 1}</span>
            <h3 class="display cap__nombre">{p.nombre}</h3>
            <p>{p.desc}</p>
            <span class="label cap__precio">{formatoPrecio(p.precio)}</span>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  :global(body) { background: #0e0c0b; }
  .hero { position: relative; min-height: 100dvh; display: grid; grid-template-rows: auto 1fr auto; overflow: hidden; }
  :global(.hero__video) { position: absolute !important; inset: 0; border: 0 !important; place-content: center end !important; padding: 0 clamp(2rem, 8vw, 9rem) 6rem 0 !important; }
  .hero__velo { position: absolute; inset: 0; background:
      linear-gradient(90deg, rgba(14,12,11,.92) 0%, rgba(14,12,11,.65) 45%, rgba(14,12,11,0) 75%),
      linear-gradient(0deg, #0e0c0b 0%, transparent 30%); }
  .nav { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; padding: 1.4rem clamp(1.2rem, 4vw, 3.5rem); }
  .nav :global(img) { width: 84px; height: auto; }
  .nav nav { display: flex; gap: 2.2rem; font-size: 1.1rem; }
  .nav a { text-decoration: none; color: var(--tortilla-dim); }
  .hero__texto { position: relative; z-index: 2; align-self: center; padding: 0 clamp(1.2rem, 6vw, 6rem); max-width: 52rem; }
  .kicker { display: flex; align-items: center; gap: .8rem; color: var(--maiz); font-size: 1.05rem; margin: 0 0 1.4rem; }
  .kicker span { width: 2.5rem; height: 2px; background: var(--maiz); }
  .titulo { font-size: clamp(3rem, 5.4vw, 5.2rem); line-height: .92; color: var(--tortilla); }
  .titulo span { display: block; white-space: nowrap; }
  .sub { max-width: 34rem; margin: 1.6rem 0 0; color: rgba(255,246,229,.72); font-size: 1.1rem; line-height: 1.65; }
  .ctas { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 2.2rem; }
  .btn { display: inline-flex; align-items: center; min-height: 52px; padding: .2rem 1.6rem 0; border-radius: 999px; text-decoration: none; font-size: 1.2rem; transition: transform .2s var(--ease-out); }
  .btn:active { transform: scale(.98); }
  .btn--sol { background: var(--maiz); color: var(--comal); }
  .btn--vidrio { background: rgba(255,246,229,.08); border: 1px solid rgba(255,246,229,.18); box-shadow: inset 0 1px 0 rgba(255,255,255,.1); backdrop-filter: blur(8px); }
  .anfitrion { position: absolute; z-index: 3; right: clamp(1rem, 5vw, 5rem); bottom: 2.5rem; margin: 0; display: flex; align-items: flex-end; gap: .4rem; animation: flota 4.5s ease-in-out infinite; }
  .anfitrion :global(img) { width: 200px; height: auto; filter: drop-shadow(0 20px 30px rgba(0,0,0,.6)); }
  .globo { order: -1; margin-bottom: 9rem; max-width: 13rem; padding: .8rem 1rem; border-radius: 16px 16px 4px 16px; background: var(--tortilla); color: var(--comal); font-weight: 700; font-size: .95rem; line-height: 1.3; box-shadow: 0 10px 30px rgba(0,0,0,.4); }
  @keyframes flota { 50% { transform: translateY(-8px); } }
  .scroll { position: relative; z-index: 2; justify-self: center; padding-bottom: 1.4rem; color: var(--tortilla-dim); font-size: .95rem; }

  .caps { padding: 7rem 0 6rem; }
  .caps__cab { padding: 0 clamp(1.2rem, 6vw, 6rem); margin-bottom: 3rem; }
  .caps__titulo { font-size: clamp(2.6rem, 5vw, 4.4rem); line-height: .95; }
  .caps__pista { display: grid; grid-auto-flow: column; grid-auto-columns: min(78vw, 340px); gap: 1.4rem; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0 clamp(1.2rem, 6vw, 6rem) 1rem; scrollbar-width: none; }
  .cap { scroll-snap-align: start; }
  :global(.cap__video) { aspect-ratio: 9 / 14; border-radius: 22px; }
  .cap__info { padding: 1.1rem .2rem 0; }
  .cap__n { color: var(--fuego); font-size: 1rem; }
  .cap__nombre { font-size: 2rem; margin: .3rem 0 .6rem; }
  .cap__info p { color: rgba(255,246,229,.65); font-size: .98rem; margin: 0 0 .8rem; }
  .cap__precio { font-size: 1.4rem; color: var(--maiz); }

  @media (max-width: 767px) {
    .nav nav { display: none; }
    .hero__velo { background: linear-gradient(0deg, #0e0c0b 15%, rgba(14,12,11,.55) 60%, rgba(14,12,11,.3)); }
    .hero__texto { align-self: end; padding-bottom: 9rem; }
    .titulo { font-size: 2.6rem; } .titulo span { white-space: normal; }
    .anfitrion { right: .5rem; bottom: 1rem; }
    .anfitrion :global(img) { width: 120px; }
    .globo { display: none; }
    :global(.hero__video) { padding: 6rem 1rem 0 !important; place-content: start center !important; }
  }
</style>
