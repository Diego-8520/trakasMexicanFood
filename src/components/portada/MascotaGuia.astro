---
// Mascota pequeña fija (escritorio) que cambia de pose según la sección visible ([data-guia]).
import { Image } from 'astro:assets';
import presentando from '../../assets/brand/mascota/chile-presentando-sticker-1024.webp';
import taco from '../../assets/brand/mascota/chile-taco-sticker-1024.webp';
import fuego from '../../assets/brand/mascota/chile-fuego-sticker-1024.webp';
import moto from '../../assets/brand/mascota/chile-moto-sticker-1024.webp';
const poses = { presentando, taco, fuego, moto };
---
<div class="guia" aria-hidden="true" data-guia-pose="">
  {Object.entries(poses).map(([nombre, img]) => (
    <Image src={img} alt="" width={110} densities={[1, 2]} quality={65} loading="lazy" data-pose={nombre} />
  ))}
</div>
<script>
  const guia = document.querySelector<HTMLElement>('.guia');
  const secciones = document.querySelectorAll<HTMLElement>('[data-guia]');
  if (guia && secciones.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const obs = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) guia.dataset.guiaPose = (e.target as HTMLElement).dataset.guia ?? '';
    }, { rootMargin: '-45% 0px -45% 0px' });
    secciones.forEach((s) => obs.observe(s));
  }
</script>
<style>
  .guia { position: fixed; left: 1.2rem; bottom: 1rem; z-index: 30; width: 110px; height: 110px; pointer-events: none; }
  .guia :global(img) { position: absolute; inset: 0; width: 100%; height: auto; display: none; filter: drop-shadow(0 10px 16px rgba(0,0,0,.5)); }
  .guia[data-guia-pose='presentando'] :global([data-pose='presentando']),
  .guia[data-guia-pose='taco'] :global([data-pose='taco']),
  .guia[data-guia-pose='fuego'] :global([data-pose='fuego']),
  .guia[data-guia-pose='moto'] :global([data-pose='moto']) { display: block; animation: asoma .5s var(--ease-bounce) both; }
  @keyframes asoma { from { transform: translateY(60px) rotate(-10deg); opacity: 0; } }
  @media (max-width: 1099px) { .guia { display: none; } }
</style>
