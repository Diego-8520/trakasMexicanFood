---
import Base from '../layouts/Base.astro';
import '../styles/portada.css';
import Hero from '../components/portada/Hero.astro';
import Cinta from '../components/portada/Cinta.astro';
import Capitulos from '../components/portada/Capitulos.astro';
import ConoceAlChile from '../components/portada/ConoceAlChile.astro';
import Nosotros from '../components/portada/Nosotros.astro';
import Domicilios from '../components/portada/Domicilios.astro';
import Visitanos from '../components/portada/Visitanos.astro';
import Pie from '../components/portada/Pie.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import { trakas, marca } from '../data/trakas';
import { resumenHorario } from '../lib/horario';
import { restaurantSchema } from '../lib/schema';
const schema = JSON.stringify(restaurantSchema(trakas, Astro.site?.href));
---
<Base
  title="Trakas Mexican Food — Birria en consomé y tortillas artesanales"
  description={`Tacos de birria con consomé en tortilla artesanal, birria ramen, burritos, gringas y dorilocos. Pide por WhatsApp ${trakas.telefonoVisible}. ${resumenHorario(trakas.horario)}.`}
>
  <script slot="head" type="application/ld+json" set:html={schema} />
  <Hero />
  <Cinta />
  <main>
    <Capitulos />
    <ConoceAlChile />
    <Nosotros />
    <Domicilios />
    <Visitanos />
  </main>
  <Pie />
  <WhatsAppCTA fijo oculto />
</Base>
